{
  "name": "web-bms",
  "private": true,
  "description": "Battery monitor for JK / JBD BMS via Web Bluetooth",
  "type": "module",
  "scripts": {
    "start": "node tests/serve.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "lint": "eslint .",
    "screenshots": "node tests/screenshots.mjs"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "playwright": "1.56.1"
  }
}
